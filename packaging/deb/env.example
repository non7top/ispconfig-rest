# Example /etc/ispconfig-rest/.env for a package install (owner root, group ispconfig-rest, mode 0640).
APP_NAME="ISPConfig REST API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
APP_TIMEZONE=UTC

LOG_CHANNEL=resilient
LOG_PATH=/var/log/ispconfig-rest/ispconfig-rest.log
LOG_LEVEL=warning

# The packaged tree is read-only: storage and the bootstrap caches live in /var/cache.
LARAVEL_STORAGE_PATH=/var/cache/ispconfig-rest/storage
APP_PACKAGES_CACHE=/var/cache/ispconfig-rest/bootstrap/packages.php
APP_SERVICES_CACHE=/var/cache/ispconfig-rest/bootstrap/services.php
APP_CONFIG_CACHE=/var/cache/ispconfig-rest/bootstrap/config.php
APP_ROUTES_CACHE=/var/cache/ispconfig-rest/bootstrap/routes.php
APP_EVENTS_CACHE=/var/cache/ispconfig-rest/bootstrap/events.php

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dbispconfig
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=log

# No dev key in production: mint keys with `ispconfig-rest key:create`.
API_DEV_KEY=
